{
    "name": "taloyhtiot/kilpailutus",
    "description": "Taloyhtiöiden remonttikilpailutuspalvelu (WordPress-lisäosa)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Kilpailutus\\": "plugin/taloyhtio-kilpailutus/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kilpailutus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find plugin -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
